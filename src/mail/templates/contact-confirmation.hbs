<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>{{title}}</title>
    <style type="text/css">
        :root {
            color-scheme: light dark;
            supported-color-schemes: light dark;
        }
        
        /* Estilos base compatibles */
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 0;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
            background-color: #ffffff;
            color: #333333;
        }
        
        @media (prefers-color-scheme: dark) {
            body {
                background-color: #121212 !important;
                color: #e0e0e0 !important;
            }
            
            .email-container {
                background-color: #1e1e1e !important;
            }
            
            .header {
                background-color: #1a237e !important;
            }
            
            .confirmation-box {
                background-color: #2d2d2d !important;
                border-left-color: #4caf50 !important;
            }
            
            .message-summary {
                background-color: #2d2d2d !important;
                border-color: #444 !important;
            }
            
            .message-summary h2 {
                color: #7986cb !important;
            }
            
            .btn {
                background-color: #1a237e !important;
            }
            
            .social-link {
                background-color: #2d2d2d !important;
                color: #7986cb !important;
            }
            
            .footer {
                border-top-color: #444 !important;
                color: #b0b0b0 !important;
            }
            
            .highlight {
                color: #7986cb !important;
            }
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #ffffff;
        }
        
        .header {
            background-color: #4361ee;
            color: #ffffff;
            padding: 30px 20px;
            text-align: center;
        }
        
        h1 {
            font-size: 24px;
            margin: 0 0 10px 0;
            font-weight: bold;
        }
        
        .subtitle {
            font-size: 16px;
            opacity: 0.9;
            margin: 0;
        }
        
        .confirmation-box {
            background-color: #f8f9fa;
            border-left: 5px solid #38b000;
            padding: 20px;
            margin: 20px 0;
        }
        
        .message-summary {
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
            padding: 20px;
            margin: 20px 0;
        }
        
        .message-summary h2 {
            font-size: 18px;
            color: #4361ee;
            margin-top: 0;
            margin-bottom: 15px;
        }
        
        .message-summary ul {
            padding-left: 20px;
            margin: 0;
        }
        
        .message-summary li {
            margin-bottom: 10px;
            list-style-type: none;
            position: relative;
            padding-left: 25px;
        }
        
        .message-summary li:before {
            content: "•";
            color: #4cc9f0;
            font-size: 24px;
            position: absolute;
            left: 0;
            top: -4px;
        }
        
        .btn {
            display: inline-block;
            background-color: #4361ee;
            color: #ffffff;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            margin: 15px 0;
            text-align: center;
        }
        
        .footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
            font-size: 14px;
            color: #777777;
            text-align: center;
        }
        
        .signature {
            font-size: 16px;
            margin-bottom: 20px;
        }
        
        .signature strong {
            color: #4361ee;
        }
        
        .social-links {
            margin: 20px 0;
            text-align: center;
        }
        
        .social-link {
            display: inline-block;
            width: 40px;
            height: 40px;
            background-color: #f8f9fa;
            color: #4361ee;
            border-radius: 50%;
            text-align: center;
            line-height: 40px;
            margin: 0 5px;
            text-decoration: none;
            font-weight: bold;
        }
        
        .contact-info {
            margin-top: 15px;
            font-size: 14px;
        }
        
        .highlight {
            color: #4361ee;
            font-weight: bold;
        }
        
        /* Estilos para móviles */
        @media screen and (max-width: 480px) {
            .email-container {
                padding: 10px;
            }
            
            .header {
                padding: 20px 15px;
            }
            
            h1 {
                font-size: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Contenedor principal con ancho fijo -->
    <div class="email-container" style="max-width: 600px; margin: 0 auto; padding: 20px; background-color: #ffffff;">
        <!-- Cabecera -->
        <div class="header" style="background-color: #4361ee; color: #ffffff; padding: 30px 20px; text-align: center;">
            <h1 style="font-size: 24px; margin: 0 0 10px 0; font-weight: bold;">¡Gracias por contactarme, {{name}}!</h1>
            <div class="subtitle" style="font-size: 16px; opacity: 0.9; margin: 0;">Tu mensaje ha sido recibido con éxito</div>
        </div>
        
        <!-- Caja de confirmación -->
        <div class="confirmation-box" style="background-color: #f8f9fa; border-left: 5px solid #38b000; padding: 20px; margin: 20px 0;">
            <p style="margin: 0 0 10px 0;">Hemos recibido tu mensaje correctamente y está siendo procesado.</p>
            <p style="margin: 0;">Te responderé lo antes posible a la dirección de correo que nos proporcionaste: <span class="highlight" style="color: #4361ee; font-weight: bold;">{{to}}</span></p>
        </div>
        
        <!-- Resumen del mensaje -->
        <div class="message-summary" style="background-color: #ffffff; border: 1px solid #e0e0e0; padding: 20px; margin: 20px 0;">
            <h2 style="font-size: 18px; color: #4361ee; margin-top: 0; margin-bottom: 15px;">Resumen de tu mensaje</h2>
            <ul style="padding-left: 20px; margin: 0;">
                <li style="margin-bottom: 10px; list-style-type: none; position: relative; padding-left: 25px;">
                    <span style="position: absolute; left: 0; top: 0; color: #4cc9f0; font-size: 24px;">•</span>
                    <strong style="display: inline-block; width: 70px;">Asunto:</strong> {{subject}}
                </li>
                <li style="margin-bottom: 10px; list-style-type: none; position: relative; padding-left: 25px;">
                    <span style="position: absolute; left: 0; top: 0; color: #4cc9f0; font-size: 24px;">•</span>
                    <strong style="display: inline-block; width: 70px;">Mensaje:</strong> {{message}}
                </li>
            </ul>
        </div>
        
        <!-- Texto centrado -->
        <p style="text-align: center; margin: 20px 0;">Si necesitas enviar información adicional, no dudes en responder a este correo.</p>
        
        <!-- Botón CTA -->
        <div style="text-align: center; margin: 20px 0;">
            <a href="{{portfolioUrl}}" class="btn" style="display: inline-block; background-color: #4361ee; color: #ffffff; padding: 12px 25px; text-decoration: none; border-radius: 50px; font-weight: bold; margin: 15px 0; text-align: center;">Visitar mi portafolio</a>
        </div>
        
        <!-- Pie de página -->
        <div class="footer" style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0; font-size: 14px; color: #777777; text-align: center;">
            <div class="signature" style="font-size: 16px; margin-bottom: 20px;">
                <p style="margin: 0;">Atentamente,</p>
                <p style="margin: 0;"><strong style="color: #4361ee;">{{portfolioName}}</strong></p>
            </div>
            
            <div class="social-links" style="margin: 20px 0; text-align: center;">
                <a href="{{linkedinUrl}}" class="social-link" style="display: inline-block; width: 40px; height: 40px; background-color: #f8f9fa; color: #4361ee; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 5px; text-decoration: none; font-weight: bold;">in</a>
                <a href="{{githubUrl}}" class="social-link" style="display: inline-block; width: 40px; height: 40px; background-color: #f8f9fa; color: #4361ee; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 5px; text-decoration: none; font-weight: bold;">git</a>
                <a href="{{twitterUrl}}" class="social-link" style="display: inline-block; width: 40px; height: 40px; background-color: #f8f9fa; color: #4361ee; border-radius: 50%; text-align: center; line-height: 40px; margin: 0 5px; text-decoration: none; font-weight: bold;">tw</a>
            </div>
            
            <div class="contact-info" style="margin-top: 15px; font-size: 14px;">
                <p style="margin: 0;">{{emailContacto}} | {{phoneNumber}}</p>
            </div>
            
            <small style="display: block; margin-top: 20px;">© {{year}} {{portfolioName}}. Todos los derechos reservados.</small>
        </div>
    </div>

    <script>
        // Añadir el año actual automáticamente
        const year = new Date().getFullYear();
        document.body.innerHTML = document.body.innerHTML.replace('{{year}}', year);
        
        // Reemplazar placeholders con información real
        const replacements = {
            '{{portfolioName}}': 'Mi Portafolio Profesional',
            '{{portfolioUrl}}': 'https://mi-portafolio.com',
            '{{linkedinUrl}}': 'https://linkedin.com/in/tuperfil',
            '{{githubUrl}}': 'https://github.com/tuperfil',
            '{{emailContacto}}': 'contacto@mi-portafolio.com',
            '{{phoneNumber}}': '+34 123 456 789'
        };
        
        for (const [key, value] of Object.entries(replacements)) {
            document.body.innerHTML = document.body.innerHTML.replace(new RegExp(key, 'g'), value);
        }
    </script>
</body>
</html>